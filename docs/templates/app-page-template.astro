---
import SiteLayout from '../../src/layouts/SiteLayout.astro';

const appName = 'APP NAME';
const status = 'In planning'; // In planning | In development | Testing | Released
---

<SiteLayout title={appName} description={`Kroma Digital product page for ${appName}.`}>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Kroma Digital App</span>
      <h1>{appName}</h1>
      <p>ONE-SENTENCE PRODUCT DESCRIPTION</p>
    </div>
  </section>

  <section class="content">
    <div class="wrap prose">
      <p><span class="tag">{status}</span></p>

      <h2>Problem</h2>
      <p>Describe the specific user problem this app addresses.</p>

      <h2>Who it is for</h2>
      <p>Describe the target user in Cambodia.</p>

      <h2>Core functions</h2>
      <ul>
        <li>FEATURE 1</li>
        <li>FEATURE 2</li>
        <li>FEATURE 3</li>
      </ul>

      <h2>Status</h2>
      <p>State clearly whether the app is planned, being built, in testing, or released.</p>

      <h2>Privacy</h2>
      <p><a href="/privacy/APP-SLUG">View this app's Privacy Policy</a></p>
    </div>
  </section>
</SiteLayout>

<!--
Usage:
1. Copy to src/pages/apps/<app-slug>.astro
2. Replace APP NAME / APP-SLUG / copy.
3. Add the app to src/pages/apps.astro.
4. Add a matching privacy page.
5. npm run build
6. git diff && git status
7. Commit and push only after build succeeds.
-->
