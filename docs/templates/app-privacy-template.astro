---
import SiteLayout from '../../src/layouts/SiteLayout.astro';

const appName = 'APP NAME';
const lastUpdated = 'MONTH DAY, YEAR';
---

<SiteLayout title={`${appName} Privacy Policy`} description={`Privacy Policy for ${appName}.`}>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">App Privacy</span>
      <h1>{appName} Privacy Policy</h1>
      <p>Privacy information for this Kroma Digital application.</p>
    </div>
  </section>

  <section class="content">
    <div class="wrap prose">
      <p><strong>Last updated: {lastUpdated}</strong></p>

      <h2>1. Data collected</h2>
      <p>Replace this section after checking the actual implementation, permissions, SDKs, analytics, advertising, crash reporting, account system, and cloud storage.</p>

      <h2>2. How data is used</h2>
      <p>Explain only purposes that exist in the released app.</p>

      <h2>3. Data sharing</h2>
      <p>List third-party processors and SDK providers where applicable. Do not claim that no data is shared until the implementation has been verified.</p>

      <h2>4. Data storage and retention</h2>
      <p>Describe local storage, cloud storage, retention, deletion, and backup behavior.</p>

      <h2>5. Permissions</h2>
      <p>Explain each Android permission used by the released build.</p>

      <h2>6. Children</h2>
      <p>Add product-appropriate language based on the intended audience and Play Console declarations.</p>

      <h2>7. Changes</h2>
      <p>State that material changes will be reflected on this page and update the date above.</p>

      <h2>8. Contact</h2>
      <p>Questions can be sent through the Kroma Digital contact channels listed on the <a href="/contact">Contact page</a>.</p>
    </div>
  </section>
</SiteLayout>

<!--
RELEASE CHECKLIST — remove this comment from the final policy if desired.
- Verify AndroidManifest permissions.
- Verify all Gradle dependencies / SDKs.
- Verify analytics and crash reporting.
- Verify ads and advertising ID use.
- Verify account/login behavior.
- Verify cloud/network transfers.
- Verify local database/storage.
- Verify backup/export behavior.
- Verify deletion/retention behavior.
- Cross-check Google Play Data safety answers.
- Replace every placeholder before publishing as the official policy.
-->
