---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<SiteLayout title="Blog" description="Updates, product notes, and practical observations from Kroma Digital.">
  <section class="page-hero"><div class="wrap"><span class="eyebrow">Kroma Digital Blog</span><h1>What we are learning and building.</h1><p>Updates about our products, local business workflows, and the problems we are trying to solve in Cambodia.</p></div></section>
  <section class="content"><div class="wrap article-list">
    {posts.map((post) => (
      <article class="article-card">
        <div class="meta">{post.data.pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
        <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
      </article>
    ))}
  </div></section>
</SiteLayout>
