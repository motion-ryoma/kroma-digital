---
import SiteLayout from '../layouts/SiteLayout.astro';

const businessApps = [
  { name:'Shop Ledger KH', status:'Closed testing', description:'Simple sales, expense, profit and business record management for small businesses in Cambodia.', play:'https://play.google.com/store/apps/details?id=com.kromadigital.shopledgerkh', privacy:'/privacy/shop-ledger-kh/' },
  { name:'Receipt Maker KH', status:'Closed testing', description:'Create and manage simple receipts for everyday business use, with export and sharing workflows.', play:'https://play.google.com/store/apps/details?id=com.kromadigital.receiptmakerkh', privacy:'/privacy/receipt-maker-kh/' },
  { name:'Booking Simple KH', status:'Closed testing', description:'Simple booking, customer and appointment management for salons, massage, repair, tutors and other services.', play:'https://play.google.com/store/apps/details?id=com.kromadigital.bookingsimplekh', privacy:'/privacy/booking-simple-kh/' },
  { name:'Seller Order KH', status:'Closed testing', description:'Order, customer, delivery and status management for Facebook and TikTok sellers.', play:'https://play.google.com/store/apps/details?id=com.kromadigital.sellerorderkh', privacy:'/privacy/seller-order-kh/' },
];

const educationApps = [
  { name:'MathLoop', status:'Available', description:'Short daily math practice for children, including missing numbers, number bonds, addition and subtraction.', play:'https://play.google.com/store/apps/details?id=com.hodaka.mathloopapp', privacy:'/privacy/mathloop/' },
  { name:'My Future Jobs', status:'In development', description:'A career exploration app that helps young learners discover occupations, compare jobs and think about their future.', play:null, privacy:'/privacy/my-future-jobs/' },
  { name:'Micro Expression Trainer', status:'In development', description:'Observation training using brief facial-expression changes to practice recognizing emotions and micro-expressions.', play:null, privacy:'/privacy/micro-expression-trainer/' },
  { name:'Khmer Work English', status:'Planned', description:'Practical workplace English for Khmer speakers with job-specific phrases, audio, quizzes and progress practice.', play:null, privacy:'/privacy/khmer-work-english/' },
];
---
<SiteLayout title="Apps" description="Business and education Android apps developed by Kroma Digital.">
<section class="page-hero"><div class="wrap"><span class="eyebrow">Kroma Digital Apps</span><h1>Practical apps for work and learning.</h1><p>Our Android apps are now presented together under Kroma Digital, with focused products for Cambodian businesses and education.</p></div></section>
<section class="content"><div class="wrap">
  <div class="prose"><h2>For Business</h2><p>Lightweight tools designed to make everyday business operations simpler.</p></div>
  <div class="grid app-grid">{businessApps.map(app => <article class="card"><span class="tag">{app.status}</span><h3>{app.name}</h3><p>{app.description}</p><div class="app-actions"><a class="btn" href={app.play} target="_blank" rel="noreferrer">Google Play</a><a class="text-link" href={app.privacy}>Privacy Policy</a></div></article>)}</div>

  <div class="prose category"><h2>For Education</h2><p>Learning and training apps built around focused practice and exploration.</p></div>
  <div class="grid app-grid">{educationApps.map(app => <article class="card"><span class="tag">{app.status}</span><h3>{app.name}</h3><p>{app.description}</p><div class="app-actions">{app.play ? <a class="btn" href={app.play} target="_blank" rel="noreferrer">Google Play</a> : <span class="coming">Google Play link coming when published</span>}<a class="text-link" href={app.privacy}>Privacy Policy</a></div></article>)}</div>
</div></section>
<style>
  .category{margin-top:64px}.app-grid{margin-top:22px}.card h3{font-size:1.35rem;margin:14px 0 8px}.app-actions{display:flex;align-items:center;flex-wrap:wrap;gap:16px;margin-top:20px}.text-link{font-weight:800;color:#1268d7}.coming{font-size:.86rem;color:#718399;font-weight:700}
</style>
</SiteLayout>