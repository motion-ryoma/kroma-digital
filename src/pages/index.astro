---
const services = [
  {
    title: 'Android Apps',
    text: 'Simple, practical Android apps designed around real business needs in Cambodia.',
  },
  {
    title: 'Digital Tools',
    text: 'Lightweight tools that reduce manual work and make everyday operations easier.',
  },
  {
    title: 'Local-first Development',
    text: 'We listen first, validate the problem, and then build only what is useful.',
  },
];

const steps = [
  ['01', 'Listen', 'We start by understanding how the work is done today and where the friction is.'],
  ['02', 'Validate', 'We confirm that the problem is frequent, costly, or time-consuming enough to solve.'],
  ['03', 'Build', 'We create a focused solution, test it quickly, and improve it from real feedback.'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Kroma Digital builds practical Android apps and digital tools for Cambodian businesses."
    />
    <meta name="theme-color" content="#0c2f2b" />
    <title>Kroma Digital | Practical Digital Tools for Cambodia</title>
    <style>
      :root {
        --bg: #f7f4ec;
        --surface: #fffdf8;
        --ink: #15302d;
        --muted: #64726f;
        --brand: #0c5b52;
        --brand-dark: #083f39;
        --accent: #d7a84a;
        --line: #dedbd1;
        --shadow: 0 20px 45px rgba(17, 52, 48, 0.08);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: var(--bg);
        color: var(--ink);
        line-height: 1.6;
      }

      a { color: inherit; text-decoration: none; }
      .wrap { width: min(1120px, calc(100% - 40px)); margin: 0 auto; }

      header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(247, 244, 236, 0.92);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid rgba(222, 219, 209, 0.8);
      }

      .nav {
        min-height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-weight: 800;
        letter-spacing: -0.02em;
      }

      .mark {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--brand), #169b87);
        position: relative;
        box-shadow: inset 0 0 0 1px rgba(255,255,255,.25);
      }

      .mark::after {
        content: '';
        position: absolute;
        inset: 9px;
        border: 3px solid rgba(255,255,255,.92);
        border-top-color: transparent;
        border-radius: 50%;
        transform: rotate(28deg);
      }

      nav ul {
        display: flex;
        align-items: center;
        gap: 26px;
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 0.95rem;
      }

      nav a:hover { color: var(--brand); }

      .hero {
        padding: 92px 0 72px;
        position: relative;
        overflow: hidden;
      }

      .hero::before {
        content: '';
        position: absolute;
        width: 420px;
        height: 420px;
        border-radius: 50%;
        right: -120px;
        top: -120px;
        background: radial-gradient(circle, rgba(215,168,74,.22), rgba(215,168,74,0));
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 56px;
        align-items: center;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        color: var(--brand);
        font-weight: 700;
        font-size: .9rem;
        letter-spacing: .05em;
        text-transform: uppercase;
      }

      .eyebrow::before {
        content: '';
        width: 28px;
        height: 2px;
        background: var(--accent);
      }

      h1 {
        font-size: clamp(2.8rem, 6vw, 5.6rem);
        line-height: .98;
        margin: 20px 0 24px;
        letter-spacing: -0.055em;
        max-width: 820px;
      }

      .hero p {
        font-size: 1.15rem;
        color: var(--muted);
        max-width: 650px;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 32px;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 22px;
        border-radius: 14px;
        font-weight: 700;
        border: 1px solid var(--brand);
      }

      .btn.primary { background: var(--brand); color: white; }
      .btn.primary:hover { background: var(--brand-dark); }
      .btn.secondary { background: transparent; color: var(--brand); }
      .btn.secondary:hover { background: rgba(12,91,82,.06); }

      .hero-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 28px;
        padding: 30px;
        box-shadow: var(--shadow);
      }

      .hero-card .label {
        font-size: .78rem;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: .08em;
        font-weight: 700;
      }

      .hero-card h2 { margin: 8px 0 20px; font-size: 1.65rem; line-height: 1.25; }
      .metric {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 16px;
        padding: 16px 0;
        border-top: 1px solid var(--line);
      }
      .metric span:last-child { font-weight: 800; color: var(--brand); }

      section { padding: 78px 0; }
      .section-head { max-width: 680px; margin-bottom: 34px; }
      .section-head h2 {
        font-size: clamp(2rem, 4vw, 3.2rem);
        line-height: 1.05;
        letter-spacing: -0.035em;
        margin: 10px 0 16px;
      }
      .section-head p { color: var(--muted); margin: 0; }

      .cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
      }

      .card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 22px;
        padding: 26px;
      }

      .card h3 { margin: 0 0 10px; font-size: 1.25rem; }
      .card p { margin: 0; color: var(--muted); }

      .process {
        background: var(--brand-dark);
        color: white;
      }
      .process .section-head p { color: rgba(255,255,255,.68); }
      .steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
      }
      .step {
        border: 1px solid rgba(255,255,255,.16);
        border-radius: 22px;
        padding: 26px;
        background: rgba(255,255,255,.045);
      }
      .step .num { color: #e2bd6a; font-weight: 800; font-size: .85rem; }
      .step h3 { font-size: 1.4rem; margin: 12px 0 10px; }
      .step p { color: rgba(255,255,255,.7); margin: 0; }

      .projects {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
      }
      .project {
        min-height: 240px;
        border-radius: 24px;
        border: 1px solid var(--line);
        padding: 28px;
        background: var(--surface);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .tag {
        display: inline-block;
        width: fit-content;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 700;
        background: rgba(12,91,82,.08);
        color: var(--brand);
      }
      .project h3 { font-size: 1.6rem; margin: 18px 0 10px; }
      .project p { color: var(--muted); max-width: 520px; }

      .cta {
        background: linear-gradient(135deg, #efe6ce, #f7f4ec);
      }
      .cta-box {
        border: 1px solid #d8ceb7;
        border-radius: 28px;
        padding: 48px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 28px;
        align-items: center;
      }
      .cta-box h2 { margin: 0 0 10px; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.06; }
      .cta-box p { margin: 0; color: var(--muted); }

      footer {
        padding: 34px 0 46px;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: .92rem;
      }
      .footer-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
      }

      @media (max-width: 820px) {
        nav ul { display: none; }
        .hero { padding-top: 58px; }
        .hero-grid,
        .cards,
        .steps,
        .projects,
        .cta-box {
          grid-template-columns: 1fr;
        }
        .hero-grid { gap: 32px; }
        .cta-box { padding: 30px; }
      }
    </style>
  </head>

  <body>
    <header>
      <div class="wrap nav">
        <a class="brand" href="#top" aria-label="Kroma Digital home">
          <span class="mark" aria-hidden="true"></span>
          <span>Kroma Digital</span>
        </a>
        <nav aria-label="Primary navigation">
          <ul>
            <li><a href="#services">What we do</a></li>
            <li><a href="#process">How we work</a></li>
            <li><a href="#projects">Projects</a></li>
            <li><a href="#contact">Contact</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="wrap hero-grid">
          <div>
            <span class="eyebrow">Built for real work in Cambodia</span>
            <h1>Simple digital tools that solve practical problems.</h1>
            <p>
              Kroma Digital creates Android apps and lightweight digital tools for Cambodian businesses.
              We start with the problem, validate the need, and build only what is useful.
            </p>
            <div class="actions">
              <a class="btn primary" href="#contact">Tell us your problem</a>
              <a class="btn secondary" href="#projects">See what we're building</a>
            </div>
          </div>

          <aside class="hero-card" aria-label="Kroma Digital approach">
            <span class="label">Our development principle</span>
            <h2>Listen first. Build second.</h2>
            <div class="metric"><span>Focus</span><span>Useful</span></div>
            <div class="metric"><span>Approach</span><span>Local-first</span></div>
            <div class="metric"><span>Platform</span><span>Android + Web</span></div>
            <div class="metric"><span>Market</span><span>Cambodia</span></div>
          </aside>
        </div>
      </section>

      <section id="services">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">What we do</span>
            <h2>Focused tools for small businesses and everyday operations.</h2>
            <p>We prefer simple products with a clear purpose over complex software that people do not need.</p>
          </div>
          <div class="cards">
            {services.map((service) => (
              <article class="card">
                <h3>{service.title}</h3>
                <p>{service.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="process" id="process">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">How we work</span>
            <h2>We do not begin by asking what app you want.</h2>
            <p>We begin by understanding the workflow, the problem, and the current workaround.</p>
          </div>
          <div class="steps">
            {steps.map(([num, title, text]) => (
              <article class="step">
                <span class="num">{num}</span>
                <h3>{title}</h3>
                <p>{text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="projects">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Projects</span>
            <h2>Products currently being explored and developed.</h2>
            <p>Our portfolio will grow from small, practical applications that can be tested with real users quickly.</p>
          </div>
          <div class="projects">
            <article class="project">
              <div>
                <span class="tag">In planning</span>
                <h3>Khmer Expense Manager</h3>
                <p>Simple income and expense tracking for Cambodia, with support for both USD and KHR.</p>
              </div>
            </article>
            <article class="project">
              <div>
                <span class="tag">In planning</span>
                <h3>Khmer Seller Book</h3>
                <p>A lightweight sales, profit, payment and delivery record tool for Facebook and TikTok sellers.</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="cta" id="contact">
        <div class="wrap">
          <div class="cta-box">
            <div>
              <h2>What part of your work is still harder than it should be?</h2>
              <p>Tell us about the task, process, or problem. We are interested in real operational pain points.</p>
            </div>
            <a class="btn primary" href="https://www.facebook.com/kromadigitalapps" target="_blank" rel="noreferrer">Contact on Facebook</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap footer-row">
        <strong>Kroma Digital</strong>
        <span>Practical Android apps and digital tools for Cambodia.</span>
        <span>© 2026 Kroma Digital</span>
      </div>
    </footer>
  </body>
</html>
