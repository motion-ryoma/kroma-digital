          <rect x="126" y="352" width="162" height="8" rx="4" fill="#c2cfdb"/>
          <rect x="126" y="380" width="70" height="24" rx="12" fill="#e8f2ff"/>
          <rect x="206" y="380" width="70" height="24" rx="12" fill="#e8f2ff"/>
          <rect x="126" y="420" width="176" height="34" rx="17" fill="#1877f2"/>
          <text x="214" y="443" text-anchor="middle" font-size="18" font-weight="800" fill="#fff">FACEBOOK</text>

          <rect x="376" y="116" width="214" height="146" rx="24" fill="#fff" filter="url(#s1)"/>
          <circle cx="414" cy="158" r="23" fill="#4285f4"/>
