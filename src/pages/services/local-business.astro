          <path d="M199 238c22 0 22 22 2 24" stroke="#fff" stroke-width="8" fill="none"/>
          <path d="M161 191c-10-17 11-19 0-36M180 191c-10-17 11-19 0-36" stroke="#fff" stroke-width="6" fill="none" opacity=".9"/>
          <rect x="126" y="314" width="152" height="10" rx="5" fill="#193d63"/>
