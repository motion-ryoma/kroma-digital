---
import SiteLayout from '../../layouts/SiteLayout.astro';

const starterItems = [
  ['Business description', 'Khmer + English'],
  ['Facebook About text', 'Khmer + English'],
  ['Google Business description', 'Khmer + English'],
  ['Facebook posts', '8 ready-to-post ideas'],
  ['Promotion posts', '2 sales-focused posts'],
  ['Review reply templates', '10 useful replies'],
  ['FAQ answers', '5 common questions'],
  ['Promotion ideas', '3 practical ideas'],
];

const audiences = ['Restaurant / Cafe', 'Beauty Salon / Nail', 'Massage / Spa', 'Hotel / Guesthouse', 'Retail Shop', 'Motorbike Rental'];
---

<SiteLayout
  title="Local Business Content Services"
  description="Ready-to-post Khmer and English Facebook and Google content for small businesses in Siem Reap. Business Starter Pack from $20 one-time."
>
  <section class="service-hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">For small businesses in Siem Reap</span>
        <h1>Your business online,<br />ready to post.</h1>
        <p class="lead">We create practical Khmer + English content for Facebook and Google so you can spend less time writing and more time running your business.</p>
        <div class="hero-actions">
          <a class="cta primary" href="https://m.me/kromadigitalapps" target="_blank" rel="noreferrer">Get 1 free sample post</a>
          <a class="cta secondary" href="#starter">See the $20 Starter Pack</a>
        </div>
        <p class="micro">No contract. Send us your business name, category and Facebook page. We will create one sample post first.</p>
      </div>
      <aside class="price-card">
        <span class="small-label">Business Starter Pack</span>
        <div class="price"><strong>$20</strong><span>one-time</span></div>
        <p>Ready-to-use content for your business in Khmer and English.</p>
        <ul>
          <li>Facebook content</li>
          <li>Google Business copy</li>
          <li>Review + FAQ templates</li>
          <li>Usually delivered within 48 hours</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="audience"><div class="wrap"><p class="kicker">Made for local businesses</p><div class="audience-grid">{audiences.map((item) => <span>{item}</span>)}</div></div></section>

  <section class="content" id="starter">
    <div class="wrap narrow-head">
      <span class="eyebrow dark">Business Starter Pack</span>
      <h2>Everything you need to improve your business profile and start posting.</h2>
      <p>Simple deliverables, clear pricing and no long-term commitment.</p>
    </div>
    <div class="wrap starter-grid">
      <div class="deliverables">
        {starterItems.map(([title, detail]) => <article><span class="check">✓</span><div><h3>{title}</h3><p>{detail}</p></div></article>)}
      </div>
      <div class="order-card">
        <h3>What we need from you</h3>
        <ul>
          <li>Business name</li>
          <li>Business category</li>
          <li>Facebook page</li>
          <li>Google Maps link, if available</li>
          <li>Main products or services</li>
          <li>Location and opening hours</li>
          <li>Phone / Telegram / WhatsApp</li>
          <li>Preferred language: Khmer, English or both</li>
        </ul>
        <p class="note">Optional: menu, prices, promotions, popular products, photos and target customers.</p>
      </div>
    </div>
  </section>

  <section class="example-section">
    <div class="wrap narrow-head">
      <span class="eyebrow dark">Before → After</span>
      <h2>See what better business content looks like.</h2>
    </div>
    <div class="wrap example-grid">
      <article class="example before">
        <span>Before</span>
        <h3>ABC Cafe</h3>
        <p>Good coffee and food in Siem Reap. Welcome everyone.</p>
      </article>
      <div class="arrow" aria-hidden="true">→</div>
      <article class="example after">
        <span>After</span>
        <h3>ABC Cafe</h3>
        <p>☕ Looking for a relaxing coffee break in Siem Reap? Enjoy freshly brewed coffee, simple food and a comfortable atmosphere. Visit us today and make your day a little brighter.</p>
        <small>#SiemReap #Cafe #GoodCoffee</small>
      </article>
    </div>
    <div class="wrap sample-callout">
      <div><strong>Try it before you buy.</strong><p>We will create one free sample Facebook post for your business.</p></div>
      <a class="cta primary" href="https://m.me/kromadigitalapps" target="_blank" rel="noreferrer">Message Kroma Digital</a>
    </div>
  </section>

  <section class="monthly-section">
    <div class="wrap monthly-card">
      <div>
        <span class="eyebrow dark">For ongoing support</span>
        <h2>Monthly Content Pack</h2>
        <p>For businesses that want fresh content every month without writing everything themselves.</p>
      </div>
      <div class="monthly-price"><strong>$25</strong><span>/ month</span></div>
      <ul>
        <li>8 Facebook posts every month</li>
        <li>2 promotion posts</li>
        <li>Khmer + English</li>
        <li>Photo ideas</li>
        <li>Hashtag suggestions</li>
      </ul>
    </div>
  </section>

  <section class="process-section">
    <div class="wrap narrow-head"><span class="eyebrow dark">How it works</span><h2>Four simple steps.</h2></div>
    <div class="wrap steps">
      <article><b>1</b><h3>Send information</h3><p>Message us your basic business details.</p></article>
      <article><b>2</b><h3>We create</h3><p>We prepare content tailored to your business.</p></article>
      <article><b>3</b><h3>You review</h3><p>Check the content and request one light revision if needed.</p></article>
      <article><b>4</b><h3>We deliver</h3><p>Receive ready-to-use content in a simple digital format.</p></article>
    </div>
  </section>

  <section class="faq-section">
    <div class="wrap faq-grid">
      <div><span class="eyebrow dark">FAQ</span><h2>Simple service. Clear scope.</h2></div>
      <div class="faqs">
        <details open><summary>Do you take the photos?</summary><p>Photo production is not included in the $20 Starter Pack. We can recommend what photos to take for your business.</p></details>
        <details><summary>How fast is delivery?</summary><p>Normal delivery is usually within 48 hours after we receive the required information.</p></details>
        <details><summary>Can I request changes?</summary><p>One light revision is included with the Starter Pack.</p></details>
        <details><summary>Do I need to subscribe?</summary><p>No. The Starter Pack is a one-time $20 service. The Monthly Content Pack is optional.</p></details>
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="wrap final-row"><div><h2>Start with one free sample post.</h2><p>No commitment. See the quality first.</p></div><a class="cta primary" href="https://m.me/kromadigitalapps" target="_blank" rel="noreferrer">Get your free sample</a></div>
  </section>

  <style>
    .service-hero{background:linear-gradient(135deg,#041426 0%,#0a3159 100%);color:#fff;padding:82px 0 74px}.hero-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:54px;align-items:center}.service-hero h1{font-size:clamp(3rem,6vw,5.2rem);line-height:.98;letter-spacing:-.055em;margin:14px 0 22px}.lead{font-size:1.2rem;max-width:730px;color:rgba(255,255,255,.78);margin:0}.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.cta{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 20px;border-radius:999px;font-weight:850}.cta.primary{background:#1877f2;color:#fff}.cta.primary:hover{background:#1268d7}.cta.secondary{border:1px solid rgba(255,255,255,.4);color:#fff}.micro{font-size:.84rem;color:rgba(255,255,255,.58);margin:14px 0 0}.price-card{background:#fff;color:var(--ink);padding:30px;border-radius:24px;box-shadow:0 24px 60px rgba(0,0,0,.22)}.small-label{font-weight:850;color:#174d86}.price{display:flex;align-items:end;gap:10px;margin:8px 0}.price strong{font-size:4rem;line-height:1;color:#0b67ce}.price span{color:var(--muted);padding-bottom:7px}.price-card p{color:var(--muted)}.price-card ul{padding-left:20px;margin:18px 0 0}.price-card li{margin:7px 0}.audience{padding:26px 0;background:#eef6ff;border-bottom:1px solid #dbe7f4}.kicker{text-align:center;font-weight:850;color:#174d86;margin:0 0 12px}.audience-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}.audience-grid span{text-align:center;background:#fff;border:1px solid #dce8f5;border-radius:12px;padding:10px 7px;font-size:.84rem;font-weight:750}.content,.example-section,.process-section,.faq-section{padding:76px 0}.narrow-head{max-width:850px;margin-bottom:30px}.eyebrow.dark{color:#0b67ce}.narrow-head h2,.faq-grid h2,.monthly-card h2,.final-cta h2{font-size:clamp(2rem,4vw,3.25rem);line-height:1.06;letter-spacing:-.04em;margin:10px 0 12px}.narrow-head p{color:var(--muted)}.starter-grid{display:grid;grid-template-columns:1.3fr .7fr;gap:22px}.deliverables{display:grid;grid-template-columns:1fr 1fr;gap:12px}.deliverables article{display:flex;gap:13px;padding:18px;border:1px solid var(--line);border-radius:16px}.check{display:grid;place-items:center;width:28px;height:28px;flex:0 0 28px;border-radius:50%;background:#e8f7ec;color:#178342;font-weight:900}.deliverables h3{font-size:1rem;margin:0 0 3px}.deliverables p{margin:0;color:var(--muted);font-size:.88rem}.order-card{padding:25px;border-radius:20px;background:#f5f8fc;border:1px solid var(--line)}.order-card h3{margin-top:0}.order-card ul{padding-left:20px}.order-card li{margin:6px 0}.note{font-size:.87rem;color:var(--muted);border-top:1px solid var(--line);padding-top:14px}.example-section{background:#f5f8fc}.example-grid{display:grid;grid-template-columns:1fr auto 1fr;gap:18px;align-items:center}.example{padding:28px;border-radius:20px;background:#fff;border:1px solid var(--line);min-height:220px}.example span{font-size:.76rem;text-transform:uppercase;letter-spacing:.08em;font-weight:900}.example.before span{color:#8a4d00}.example.after span{color:#0b67ce}.example p{color:var(--muted)}.example small{color:#1268d7}.arrow{font-size:2rem;font-weight:900;color:#0b67ce}.sample-callout{margin-top:22px;display:flex;justify-content:space-between;align-items:center;gap:24px;padding:22px 26px;background:#081d36;color:#fff;border-radius:20px}.sample-callout strong{font-size:1.25rem}.sample-callout p{margin:3px 0 0;color:rgba(255,255,255,.68)}.monthly-section{padding:18px 0 76px;background:#f5f8fc}.monthly-card{display:grid;grid-template-columns:1.15fr auto .85fr;gap:32px;align-items:center;padding:30px;background:linear-gradient(135deg,#eaffed,#f8fff9);border:1px solid #cdebd2;border-radius:24px}.monthly-card p{color:var(--muted)}.monthly-price strong{font-size:3.25rem;color:#0c7a38}.monthly-price span{color:var(--muted)}.monthly-card ul{margin:0;padding-left:20px}.monthly-card li{margin:7px 0}.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.steps article{padding:24px;border:1px solid var(--line);border-radius:18px}.steps b{display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:#e8f2ff;color:#1268d7}.steps h3{margin:14px 0 7px}.steps p{margin:0;color:var(--muted)}.faq-section{background:#f8fbff}.faq-grid{display:grid;grid-template-columns:.65fr 1.35fr;gap:46px}.faqs{display:grid;gap:10px}.faqs details{background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px 18px}.faqs summary{font-weight:850;cursor:pointer}.faqs p{margin:10px 0 0;color:var(--muted)}.final-cta{padding:50px 0;background:#071f3b;color:#fff}.final-row{display:flex;align-items:center;justify-content:space-between;gap:30px}.final-cta h2{margin:0 0 6px}.final-cta p{margin:0;color:rgba(255,255,255,.68)}
    @media(max-width:900px){.hero-grid,.starter-grid,.monthly-card,.faq-grid{grid-template-columns:1fr}.audience-grid{grid-template-columns:repeat(3,1fr)}.steps{grid-template-columns:1fr 1fr}.monthly-price{display:flex;align-items:end;gap:8px}}
    @media(max-width:640px){.service-hero{padding:58px 0}.deliverables,.steps{grid-template-columns:1fr}.audience-grid{grid-template-columns:1fr 1fr}.example-grid{grid-template-columns:1fr}.arrow{transform:rotate(90deg);text-align:center}.sample-callout,.final-row{align-items:flex-start;flex-direction:column}.price strong{font-size:3.4rem}.content,.example-section,.process-section,.faq-section{padding:58px 0}}
  </style>
</SiteLayout>
