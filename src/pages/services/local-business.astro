        <div class="monthly-price"><strong>$25</strong><span>/ month</span></div>
      </div>
      <div class="monthly-icons">
        <div><span>📘</span><b>8 Facebook Posts</b></div>
        <div><span>📣</span><b>2 Promotion Posts</b></div>
        <div><span>🇰🇭</span><b>Khmer + English</b></div>
        <div><span>📷</span><b data-i18n data-km="គំនិតរូបថត" data-en="Photo ideas">គំនិតរូបថត</b></div>
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="wrap final-card">
      <div class="final-icon">💬</div>
      <h2 data-i18n data-km="ចាប់ផ្តើមដោយឥតគិតថ្លៃ" data-en="Start for free">ចាប់ផ្តើមដោយឥតគិតថ្លៃ</h2>
      <p data-i18n data-km="ផ្ញើ Facebook Page របស់អ្នកមកយើង។ យើងនឹងធ្វើ Post គំរូ 1 ឱ្យមើល។" data-en="Send us your Facebook page. We will make one sample post for you.">ផ្ញើ Facebook Page របស់អ្នកមកយើង។ យើងនឹងធ្វើ Post គំរូ 1 ឱ្យមើល។</p>
