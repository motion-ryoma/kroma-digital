---
import SiteLayout from '../../layouts/SiteLayout.astro';

const audiences = [
  ['🍜','ភោជនីយដ្ឋាន','Restaurant'],
  ['☕','កាហ្វេ','Cafe'],
  ['💇','ហាងសម្អាង','Salon'],
  ['💆','ម៉ាស្សា / ស្ប៉ា','Massage / Spa'],
  ['🏨','សណ្ឋាគារ','Hotel'],
  ['🛍️','ហាងលក់រាយ','Retail'],
];

const starter = [
  ['📘','Facebook','8 Posts'],
  ['📣','Promotion','2 Posts'],
  ['📍','Google Business','Description'],
  ['⭐','Review Reply','10 Templates'],
  ['❓','FAQ','5 Answers'],
  ['💡','Promotion Ideas','3 Ideas'],
];
---

<SiteLayout
  title="សេវាមាតិកាសម្រាប់អាជីវកម្មក្នុងសៀមរាប"
  description="មាតិកា Facebook និង Google ជាភាសាខ្មែរ និងអង់គ្លេស សម្រាប់អាជីវកម្មតូចៗនៅសៀមរាប។ Starter Pack $20 បង់ម្តង។"
>
  <section class="hero-visual">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="pill" data-i18n data-km="សម្រាប់អាជីវកម្មតូចៗនៅសៀមរាប" data-en="For small businesses in Siem Reap">សម្រាប់អាជីវកម្មតូចៗនៅសៀមរាប</span>
        <h1 data-i18n data-km="ឱ្យអាជីវកម្មរបស់អ្នកមើលទៅល្អលើ Facebook" data-en="Make your business look better on Facebook">ឱ្យអាជីវកម្មរបស់អ្នកមើលទៅល្អលើ Facebook</h1>
        <p class="hero-sub" data-i18n data-km="យើងរៀបចំ Post ជាភាសាខ្មែរ + English។ អ្នកគ្រាន់តែ Copy & Post។" data-en="We create Khmer + English posts. You just Copy & Post.">យើងរៀបចំ Post ជាភាសាខ្មែរ + English។ អ្នកគ្រាន់តែ Copy & Post។</p>
        <div class="hero-price"><strong>$20</strong><span data-i18n data-km="បង់ម្តង" data-en="one-time">បង់ម្តង</span></div>
        <div class="hero-actions">
          <a class="cta primary" href="https://m.me/kromadigitalapps" target="_blank" rel="noreferrer"><span>💬</span><span data-i18n data-km="សុំ Post គំរូឥតគិតថ្លៃ" data-en="Get a free sample post">សុំ Post គំរូឥតគិតថ្លៃ</span></a>
          <a class="cta ghost" href="#starter" data-i18n data-km="មើលអ្វីដែលអ្នកទទួលបាន" data-en="See what you get">មើលអ្វីដែលអ្នកទទួលបាន</a>
        </div>
      </div>

      <div class="hero-art" aria-label="Facebook content service illustration">
        <svg viewBox="0 0 640 520" role="img">
          <defs>
            <linearGradient id="bg" x1="0" x2="1"><stop offset="0" stop-color="#eaf3ff"/><stop offset="1" stop-color="#ffffff"/></linearGradient>
            <filter id="shadow"><feDropShadow dx="0" dy="12" stdDeviation="14" flood-opacity=".16"/></filter>
          </defs>
          <rect x="28" y="26" width="584" height="468" rx="34" fill="url(#bg)"/>
          <rect x="64" y="72" width="236" height="350" rx="26" fill="#fff" filter="url(#shadow)"/>
          <rect x="80" y="92" width="204" height="38" rx="12" fill="#1877f2"/>
          <circle cx="105" cy="111" r="10" fill="#fff" opacity=".95"/>
          <rect x="124" y="103" width="76" height="7" rx="4" fill="#fff"/>
          <rect x="124" y="115" width="48" height="6" rx="3" fill="#dbeaff"/>
          <rect x="83" y="148" width="198" height="116" rx="16" fill="#ffd98c"/>
          <circle cx="140" cy="203" r="35" fill="#9b5d2e"/>
          <path d="M117 200c13-28 34-28 46 0-8 9-37 9-46 0z" fill="#fff" opacity=".92"/>
          <rect x="91" y="284" width="146" height="10" rx="5" fill="#17395f"/>
          <rect x="91" y="305" width="180" height="8" rx="4" fill="#9aabc0"/>
          <rect x="91" y="321" width="164" height="8" rx="4" fill="#c2cfdd"/>
          <rect x="91" y="345" width="56" height="20" rx="10" fill="#e8f2ff"/>
          <rect x="155" y="345" width="56" height="20" rx="10" fill="#e8f2ff"/>
          <rect x="219" y="345" width="56" height="20" rx="10" fill="#e8f2ff"/>
          <rect x="338" y="92" width="222" height="88" rx="20" fill="#fff" filter="url(#shadow)"/>
          <circle cx="376" cy="136" r="23" fill="#1877f2"/>
          <path d="M369 136h15M376 128v16" stroke="#fff" stroke-width="5" stroke-linecap="round"/>
          <rect x="414" y="116" width="112" height="9" rx="5" fill="#17395f"/>
          <rect x="414" y="136" width="90" height="8" rx="4" fill="#9aabc0"/>
          <rect x="414" y="153" width="72" height="7" rx="4" fill="#c2cfdd"/>
          <rect x="330" y="214" width="238" height="172" rx="24" fill="#071f3b" filter="url(#shadow)"/>
          <text x="365" y="263" font-size="28" font-weight="800" fill="#fff">Khmer + English</text>
          <text x="365" y="304" font-size="22" font-weight="700" fill="#77b8ff">Facebook Posts</text>
          <rect x="365" y="329" width="155" height="34" rx="17" fill="#1877f2"/>
          <text x="442" y="352" text-anchor="middle" font-size="18" font-weight="800" fill="#fff">Copy & Post</text>
          <circle cx="536" cy="424" r="54" fill="#17a05e" filter="url(#shadow)"/>
          <path d="M513 426l16 16 31-35" stroke="#fff" stroke-width="11" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="91" cy="444" r="24" fill="#f04438"/>
          <path d="M82 444h18M91 435v18" stroke="#fff" stroke-width="5" stroke-linecap="round"/>
        </svg>
      </div>
    </div>
  </section>

  <section class="audience-section">
    <div class="wrap">
      <h2 class="center-title" data-i18n data-km="សម្រាប់អាជីវកម្មរបស់អ្នក" data-en="Made for businesses like yours">សម្រាប់អាជីវកម្មរបស់អ្នក</h2>
      <div class="audience-grid">
        {audiences.map(([icon,km,en]) => <div class="audience-card"><div class="emoji">{icon}</div><strong data-i18n data-km={km} data-en={en}>{km}</strong></div>)}
      </div>
    </div>
  </section>

  <section class="before-after">
    <div class="wrap">
      <div class="section-heading">
        <span class="eyebrow dark">Before → After</span>
        <h2 data-i18n data-km="ឱ្យអតិថិជនយល់ភ្លាមៗ" data-en="Help customers understand instantly">ឱ្យអតិថិជនយល់ភ្លាមៗ</h2>
      </div>
      <div class="compare-grid">
        <div class="phone-card bad">
          <div class="phone-top"><span class="avatar">☕</span><div><b>ABC Cafe</b><small>Facebook</small></div></div>
          <div class="photo placeholder"><span>📷</span></div>
          <p>Good coffee and food. Welcome everyone.</p>
          <div class="metrics"><span>👍 2</span><span>💬 0</span></div>
          <div class="label" data-i18n data-km="មុន" data-en="Before">មុន</div>
        </div>
        <div class="big-arrow">→</div>
        <div class="phone-card good">
          <div class="phone-top"><span class="avatar">☕</span><div><b>ABC Cafe</b><small>Facebook</small></div></div>
          <div class="photo cafe-art">
            <svg viewBox="0 0 420 230"><rect width="420" height="230" rx="18" fill="#f4d39a"/><rect y="150" width="420" height="80" fill="#8f5a32"/><circle cx="105" cy="95" r="42" fill="#fff4dc"/><path d="M70 112h70l-8 28H78z" fill="#fff"/><path d="M140 119c30 0 31 29 3 31" stroke="#fff" stroke-width="10" fill="none"/><path d="M93 80c-13-25 14-26 0-50M112 79c-13-25 14-26 0-50" stroke="#fff" stroke-width="7" opacity=".8" fill="none"/><rect x="234" y="38" width="145" height="85" rx="12" fill="#fff" opacity=".82"/><circle cx="269" cy="81" r="18" fill="#eab65f"/><path d="M250 109c14-30 33-30 46 0" fill="#6da76d"/><rect x="304" y="62" width="52" height="8" rx="4" fill="#8e6136"/><rect x="304" y="80" width="40" height="7" rx="4" fill="#ba8b5b"/></svg>
          </div>
          <p data-i18n data-km="☕ សម្រាកបន្តិចជាមួយកាហ្វេឆ្ងាញ់ និងបរិយាកាសស្ងប់ស្ងាត់នៅសៀមរាប។ សូមអញ្ជើញមកលេងយើងថ្ងៃនេះ!" data-en="☕ Enjoy fresh coffee and a relaxing atmosphere in Siem Reap. Visit us today!">☕ សម្រាកបន្តិចជាមួយកាហ្វេឆ្ងាញ់ និងបរិយាកាសស្ងប់ស្ងាត់នៅសៀមរាប។ សូមអញ្ជើញមកលេងយើងថ្ងៃនេះ!</p>
          <div class="metrics"><span>👍 38</span><span>💬 7</span></div>
          <div class="label" data-i18n data-km="ក្រោយ" data-en="After">ក្រោយ</div>
        </div>
      </div>
    </div>
  </section>

  <section class="starter-section" id="starter">
    <div class="wrap starter-layout">
      <div class="starter-art">
        <svg viewBox="0 0 560 560" role="img">
          <rect x="40" y="55" width="480" height="450" rx="38" fill="#eef6ff"/>
          <rect x="104" y="108" width="352" height="310" rx="24" fill="#fff" stroke="#d7e4f3" stroke-width="3"/>
          <rect x="104" y="108" width="352" height="62" rx="24" fill="#1877f2"/>
          <text x="280" y="148" text-anchor="middle" font-size="26" font-weight="800" fill="#fff">BUSINESS STARTER PACK</text>
          <circle cx="154" cy="222" r="28" fill="#e8f2ff"/><text x="154" y="231" text-anchor="middle" font-size="28">📘</text>
          <rect x="198" y="206" width="170" height="12" rx="6" fill="#17395f"/><rect x="198" y="229" width="126" height="8" rx="4" fill="#a8b6c8"/>
          <circle cx="154" cy="297" r="28" fill="#fff4d8"/><text x="154" y="306" text-anchor="middle" font-size="28">📣</text>
          <rect x="198" y="281" width="155" height="12" rx="6" fill="#17395f"/><rect x="198" y="304" width="112" height="8" rx="4" fill="#a8b6c8"/>
          <circle cx="154" cy="372" r="28" fill="#e9f9ef"/><text x="154" y="381" text-anchor="middle" font-size="28">⭐</text>
          <rect x="198" y="356" width="144" height="12" rx="6" fill="#17395f"/><rect x="198" y="379" width="132" height="8" rx="4" fill="#a8b6c8"/>
          <circle cx="421" cy="446" r="68" fill="#071f3b"/>
          <text x="421" y="438" text-anchor="middle" font-size="44" font-weight="900" fill="#fff">$20</text>
          <text x="421" y="466" text-anchor="middle" font-size="16" font-weight="700" fill="#77b8ff">ONE-TIME</text>
        </svg>
      </div>
      <div>
        <span class="eyebrow dark">Business Starter Pack</span>
        <h2 data-i18n data-km="ទទួលបានអ្វីខ្លះ?" data-en="What do you get?">ទទួលបានអ្វីខ្លះ?</h2>
        <div class="starter-grid">
          {starter.map(([icon,title,detail]) => <article><span>{icon}</span><div><b>{title}</b><small>{detail}</small></div></article>)}
        </div>
        <div class="price-strip"><strong>$20</strong><span data-i18n data-km="បង់ម្តង • ជាទូទៅរួចរាល់ក្នុង 48 ម៉ោង" data-en="One-time • Usually ready within 48 hours">បង់ម្តង • ជាទូទៅរួចរាល់ក្នុង 48 ម៉ោង</span></div>
      </div>
    </div>
  </section>

  <section class="how-section">
    <div class="wrap">
      <div class="section-heading center">
        <span class="eyebrow dark" data-i18n data-km="ងាយស្រួល" data-en="Simple">ងាយស្រួល</span>
        <h2 data-i18n data-km="ត្រឹម 3 ជំហាន" data-en="Only 3 steps">ត្រឹម 3 ជំហាន</h2>
      </div>
      <div class="steps-visual">
        <article><div class="step-art chat"><span>💬</span></div><b>1</b><h3 data-i18n data-km="ផ្ញើព័ត៌មាន" data-en="Send your info">ផ្ញើព័ត៌មាន</h3><p data-i18n data-km="ឈ្មោះអាជីវកម្ម + Facebook" data-en="Business name + Facebook">ឈ្មោះអាជីវកម្ម + Facebook</p></article>
        <div class="flow-arrow">→</div>
        <article><div class="step-art create"><span>✨</span></div><b>2</b><h3 data-i18n data-km="យើងរៀបចំ" data-en="We create">យើងរៀបចំ</h3><p>Khmer + English</p></article>
        <div class="flow-arrow">→</div>
        <article><div class="step-art post"><span>📱</span></div><b>3</b><h3 data-i18n data-km="អ្នកបង្ហោះ" data-en="You post">អ្នកបង្ហោះ</h3><p>Copy & Post</p></article>
      </div>
    </div>
  </section>

  <section class="free-sample">
    <div class="wrap sample-grid">
      <div class="sample-art">
        <svg viewBox="0 0 520 360"><rect x="30" y="32" width="460" height="296" rx="30" fill="#fff"/><rect x="65" y="70" width="170" height="220" rx="20" fill="#eef6ff"/><rect x="86" y="94" width="128" height="74" rx="14" fill="#ffd98c"/><circle cx="122" cy="131" r="22" fill="#9b5d2e"/><rect x="91" y="190" width="115" height="10" rx="5" fill="#17395f"/><rect x="91" y="212" width="98" height="8" rx="4" fill="#a8b6c8"/><rect x="91" y="230" width="110" height="8" rx="4" fill="#c4cfdd"/><circle cx="338" cy="135" r="76" fill="#1877f2"/><text x="338" y="126" text-anchor="middle" font-size="28" font-weight="800" fill="#fff">FREE</text><text x="338" y="158" text-anchor="middle" font-size="22" font-weight="700" fill="#dbeaff">1 SAMPLE POST</text><path d="M255 238c41 0 61-22 84-48" stroke="#0b67ce" stroke-width="8" fill="none" stroke-linecap="round"/><path d="M331 186l15 4-4 15" stroke="#0b67ce" stroke-width="7" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div>
        <span class="pill light" data-i18n data-km="សាកមុន • មិនចាំបាច់បង់ប្រាក់" data-en="Try first • No payment needed">សាកមុន • មិនចាំបាច់បង់ប្រាក់</span>
        <h2 data-i18n data-km="យើងធ្វើ Post គំរូ 1 ឱ្យអ្នកឥតគិតថ្លៃ" data-en="We make 1 free sample post for your business">យើងធ្វើ Post គំរូ 1 ឱ្យអ្នកឥតគិតថ្លៃ</h2>
        <p data-i18n data-km="មើលគុណភាពជាមុន។ ពេញចិត្តទើបសម្រេចចិត្តទិញ។" data-en="See the quality first. Buy only if you like it.">មើលគុណភាពជាមុន។ ពេញចិត្តទើបសម្រេចចិត្តទិញ។</p>
        <a class="cta white" href="https://m.me/kromadigitalapps" target="_blank" rel="noreferrer">💬 <span data-i18n data-km="ផ្ញើសារមក Kroma Digital" data-en="Message Kroma Digital">ផ្ញើសារមក Kroma Digital</span></a>
      </div>
    </div>
  </section>

  <section class="monthly-section">
