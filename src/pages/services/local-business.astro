---
import SiteLayout from '../../layouts/SiteLayout.astro';

const audiences = [
  ['ភោជនីយដ្ឋាន / កាហ្វេ', 'Restaurant / Cafe'],
  ['ហាងសម្អាង / ក្រចក', 'Beauty Salon / Nail'],
  ['ម៉ាស្សា / ស្ប៉ា', 'Massage / Spa'],
  ['សណ្ឋាគារ / ផ្ទះសំណាក់', 'Hotel / Guesthouse'],
  ['ហាងលក់រាយ', 'Retail Shop'],
  ['ជួលម៉ូតូ', 'Motorbike Rental'],
];
---

<SiteLayout
  title="សេវាមាតិកាសម្រាប់អាជីវកម្មក្នុងសៀមរាប"
  description="មាតិកា Facebook និង Google ជាភាសាខ្មែរ និងអង់គ្លេស សម្រាប់អាជីវកម្មតូចៗនៅសៀមរាប។ Business Starter Pack តម្លៃ $20 បង់ម្តង។"
>
  <section class="service-hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow" data-i18n data-km="សម្រាប់អាជីវកម្មតូចៗនៅសៀមរាប" data-en="For small businesses in Siem Reap">សម្រាប់អាជីវកម្មតូចៗនៅសៀមរាប</span>
        <h1 data-i18n data-km="ធ្វើឱ្យអាជីវកម្មរបស់អ្នកមើលទៅល្អលើអនឡាញ និងត្រៀមបង្ហោះភ្លាមៗ។" data-en="Your business online, ready to post.">ធ្វើឱ្យអាជីវកម្មរបស់អ្នកមើលទៅល្អលើអនឡាញ និងត្រៀមបង្ហោះភ្លាមៗ។</h1>
        <p class="lead" data-i18n data-km="យើងរៀបចំមាតិកា Facebook និង Google ជាភាសាខ្មែរ + អង់គ្លេស ដើម្បីឱ្យអ្នកចំណាយពេលតិចលើការសរសេរ និងមានពេលច្រើនសម្រាប់អាជីវកម្មរបស់អ្នក។" data-en="We create practical Khmer + English content for Facebook and Google so you can spend less time writing and more time running your business.">យើងរៀបចំមាតិកា Facebook និង Google ជាភាសាខ្មែរ + អង់គ្លេស ដើម្បីឱ្យអ្នកចំណាយពេលតិចលើការសរសេរ និងមានពេលច្រើនសម្រាប់អាជីវកម្មរបស់អ្នក។</p>
        <div class="hero-actions">
          <a class="cta primary" href="https://m.me/kromadigitalapps" target="_blank" rel="noreferrer" data-i18n data-km="ទទួលបានគំរូ Post ឥតគិតថ្លៃ 1" data-en="Get 1 free sample post">ទទួលបានគំរូ Post ឥតគិតថ្លៃ 1</a>
          <a class="cta secondary" href="#starter" data-i18n data-km="មើល Starter Pack $20" data-en="See the $20 Starter Pack">មើល Starter Pack $20</a>
        </div>
        <p class="micro" data-i18n data-km="គ្មានកិច្ចសន្យា។ ផ្ញើឈ្មោះអាជីវកម្ម ប្រភេទអាជីវកម្ម និង Facebook Page របស់អ្នកមកយើង។ យើងនឹងបង្កើត Post គំរូមួយឱ្យមើលជាមុន។" data-en="No contract. Send us your business name, category and Facebook page. We will create one sample post first.">គ្មានកិច្ចសន្យា។ ផ្ញើឈ្មោះអាជីវកម្ម ប្រភេទអាជីវកម្ម និង Facebook Page របស់អ្នកមកយើង។ យើងនឹងបង្កើត Post គំរូមួយឱ្យមើលជាមុន។</p>
      </div>
      <aside class="price-card">
        <span class="small-label">Business Starter Pack</span>
        <div class="price"><strong>$20</strong><span data-i18n data-km="បង់ម្តង" data-en="one-time">បង់ម្តង</span></div>
        <p data-i18n data-km="មាតិកាត្រៀមប្រើសម្រាប់អាជីវកម្មរបស់អ្នក ជាភាសាខ្មែរ និងអង់គ្លេស។" data-en="Ready-to-use content for your business in Khmer and English.">មាតិកាត្រៀមប្រើសម្រាប់អាជីវកម្មរបស់អ្នក ជាភាសាខ្មែរ និងអង់គ្លេស។</p>
        <ul>
          <li data-i18n data-km="មាតិកា Facebook" data-en="Facebook content">មាតិកា Facebook</li>
          <li data-i18n data-km="អត្ថបទ Google Business" data-en="Google Business copy">អត្ថបទ Google Business</li>
          <li data-i18n data-km="គំរូឆ្លើយតប Review + FAQ" data-en="Review + FAQ templates">គំរូឆ្លើយតប Review + FAQ</li>
          <li data-i18n data-km="ជាទូទៅដឹកជញ្ជូនក្នុងរយៈពេល 48 ម៉ោង" data-en="Usually delivered within 48 hours">ជាទូទៅដឹកជញ្ជូនក្នុងរយៈពេល 48 ម៉ោង</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="audience"><div class="wrap"><p class="kicker" data-i18n data-km="សម្រាប់អាជីវកម្មក្នុងតំបន់" data-en="Made for local businesses">សម្រាប់អាជីវកម្មក្នុងតំបន់</p><div class="audience-grid">{audiences.map(([km,en]) => <span data-i18n data-km={km} data-en={en}>{km}</span>)}</div></div></section>

  <section class="content" id="starter">
    <div class="wrap narrow-head">
      <span class="eyebrow dark">Business Starter Pack</span>
      <h2 data-i18n data-km="អ្វីដែលអ្នកត្រូវការ ដើម្បីកែលម្អ Profile អាជីវកម្ម និងចាប់ផ្តើមបង្ហោះបានភ្លាមៗ។" data-en="Everything you need to improve your business profile and start posting.">អ្វីដែលអ្នកត្រូវការ ដើម្បីកែលម្អ Profile អាជីវកម្ម និងចាប់ផ្តើមបង្ហោះបានភ្លាមៗ។</h2>
      <p data-i18n data-km="តម្លៃច្បាស់លាស់ មាតិកាច្បាស់លាស់ និងគ្មានការបង្ខំឱ្យបន្តប្រចាំខែ។" data-en="Simple deliverables, clear pricing and no long-term commitment.">តម្លៃច្បាស់លាស់ មាតិកាច្បាស់លាស់ និងគ្មានការបង្ខំឱ្យបន្តប្រចាំខែ។</p>
    </div>
    <div class="wrap starter-grid">
      <div class="deliverables">
        <article><span class="check">✓</span><div><h3 data-i18n data-km="ពិពណ៌នាអាជីវកម្ម" data-en="Business description">ពិពណ៌នាអាជីវកម្ម</h3><p>Khmer + English</p></div></article>
        <article><span class="check">✓</span><div><h3>Facebook About</h3><p>Khmer + English</p></div></article>
        <article><span class="check">✓</span><div><h3>Google Business</h3><p>Khmer + English</p></div></article>
        <article><span class="check">✓</span><div><h3 data-i18n data-km="Facebook Posts" data-en="Facebook posts">Facebook Posts</h3><p data-i18n data-km="8 Post ត្រៀមប្រើ" data-en="8 ready-to-post ideas">8 Post ត្រៀមប្រើ</p></div></article>
        <article><span class="check">✓</span><div><h3 data-i18n data-km="Post ផ្សព្វផ្សាយ" data-en="Promotion posts">Post ផ្សព្វផ្សាយ</h3><p data-i18n data-km="2 Post សម្រាប់ការលក់" data-en="2 sales-focused posts">2 Post សម្រាប់ការលក់</p></div></article>
        <article><span class="check">✓</span><div><h3 data-i18n data-km="គំរូឆ្លើយតប Review" data-en="Review reply templates">គំរូឆ្លើយតប Review</h3><p data-i18n data-km="10 គំរូ" data-en="10 useful replies">10 គំរូ</p></div></article>
        <article><span class="check">✓</span><div><h3>FAQ</h3><p data-i18n data-km="5 សំណួរ និងចម្លើយទូទៅ" data-en="5 common questions">5 សំណួរ និងចម្លើយទូទៅ</p></div></article>
        <article><span class="check">✓</span><div><h3 data-i18n data-km="គំនិតផ្សព្វផ្សាយ" data-en="Promotion ideas">គំនិតផ្សព្វផ្សាយ</h3><p data-i18n data-km="3 គំនិតអនុវត្តបាន" data-en="3 practical ideas">3 គំនិតអនុវត្តបាន</p></div></article>
      </div>
      <div class="order-card">
        <h3 data-i18n data-km="ព័ត៌មានដែលយើងត្រូវការពីអ្នក" data-en="What we need from you">ព័ត៌មានដែលយើងត្រូវការពីអ្នក</h3>
        <ul>
          <li data-i18n data-km="ឈ្មោះអាជីវកម្ម" data-en="Business name">ឈ្មោះអាជីវកម្ម</li>
          <li data-i18n data-km="ប្រភេទអាជីវកម្ម" data-en="Business category">ប្រភេទអាជីវកម្ម</li>
          <li>Facebook Page</li>
          <li data-i18n data-km="Google Maps link ប្រសិនបើមាន" data-en="Google Maps link, if available">Google Maps link ប្រសិនបើមាន</li>
          <li data-i18n data-km="ផលិតផល ឬសេវាសំខាន់ៗ" data-en="Main products or services">ផលិតផល ឬសេវាសំខាន់ៗ</li>
          <li data-i18n data-km="ទីតាំង និងម៉ោងបើក" data-en="Location and opening hours">ទីតាំង និងម៉ោងបើក</li>
          <li>Phone / Telegram / WhatsApp</li>
          <li data-i18n data-km="ភាសាដែលចង់បាន៖ ខ្មែរ អង់គ្លេស ឬទាំងពីរ" data-en="Preferred language: Khmer, English or both">ភាសាដែលចង់បាន៖ ខ្មែរ អង់គ្លេស ឬទាំងពីរ</li>
        </ul>
        <p class="note" data-i18n data-km="បើមាន សូមផ្ញើ៖ Menu តម្លៃ Promotion ផលិតផលពេញនិយម រូបថត និងក្រុមអតិថិជនគោលដៅ។" data-en="Optional: menu, prices, promotions, popular products, photos and target customers.">បើមាន សូមផ្ញើ៖ Menu តម្លៃ Promotion ផលិតផលពេញនិយម រូបថត និងក្រុមអតិថិជនគោលដៅ។</p>
      </div>
    </div>
  </section>

  <section class="example-section">
    <div class="wrap narrow-head">
      <span class="eyebrow dark">Before → After</span>
      <h2 data-i18n data-km="មើលភាពខុសគ្នាមុន និងក្រោយកែលម្អមាតិកា។" data-en="See what better business content looks like.">មើលភាពខុសគ្នាមុន និងក្រោយកែលម្អមាតិកា។</h2>
    </div>
    <div class="wrap example-grid">
      <article class="example before"><span>Before</span><h3>ABC Cafe</h3><p data-i18n data-km="កាហ្វេ និងអាហារល្អនៅសៀមរាប។ សូមស្វាគមន៍ទាំងអស់គ្នា។" data-en="Good coffee and food in Siem Reap. Welcome everyone.">កាហ្វេ និងអាហារល្អនៅសៀមរាប។ សូមស្វាគមន៍ទាំងអស់គ្នា។</p></article>
      <div class="arrow" aria-hidden="true">→</div>
      <article class="example after"><span>After</span><h3>ABC Cafe</h3><p data-i18n data-km="☕ កំពុងស្វែងរកកន្លែងសម្រាកជាមួយកាហ្វេល្អនៅសៀមរាបមែនទេ? សូមរីករាយជាមួយកាហ្វេស្រស់ អាហារសាមញ្ញ និងបរិយាកាសផាសុកភាព។ មកលេងយើងថ្ងៃនេះ ហើយធ្វើឱ្យថ្ងៃរបស់អ្នកកាន់តែល្អ។" data-en="☕ Looking for a relaxing coffee break in Siem Reap? Enjoy freshly brewed coffee, simple food and a comfortable atmosphere. Visit us today and make your day a little brighter.">☕ កំពុងស្វែងរកកន្លែងសម្រាកជាមួយកាហ្វេល្អនៅសៀមរាបមែនទេ? សូមរីករាយជាមួយកាហ្វេស្រស់ អាហារសាមញ្ញ និងបរិយាកាសផាសុកភាព។ មកលេងយើងថ្ងៃនេះ ហើយធ្វើឱ្យថ្ងៃរបស់អ្នកកាន់តែល្អ។</p><small>#SiemReap #Cafe #GoodCoffee</small></article>
    </div>
