          <rect x="397" y="225" width="136" height="8" rx="4" fill="#bdc9d6"/>

          <rect x="360" y="300" width="250" height="140" rx="24" fill="#fff" filter="url(#s1)"/>
          <text x="485" y="342" text-anchor="middle" font-size="24" font-weight="900" fill="#0b2c4f">ខ្មែរ + English</text>
