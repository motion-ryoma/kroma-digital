---
const { title, description = 'Kroma Digital builds practical Android apps and digital tools for Cambodian businesses.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#061a31" />
  <link rel="icon" href="/favicon.svg" />
  <title>{title} | Kroma Digital</title>
  <style is:global>
    :root{--navy:#061a31;--navy2:#0c345f;--blue:#1877f2;--red:#f04438;--gold:#ffb21a;--ink:#0c2440;--muted:#5f7186;--line:#dfe6ee;--soft:#f5f8fc;--white:#fff}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:#fff;line-height:1.65}a{text-decoration:none;color:inherit}.wrap{width:min(1120px,calc(100% - 40px));margin:auto}
    header{position:sticky;top:0;z-index:50;background:rgba(5,24,45,.97);border-bottom:1px solid rgba(255,255,255,.08)}.nav{min-height:72px;display:flex;align-items:center;justify-content:space-between;gap:24px;color:#fff}.brand{display:flex;align-items:center;gap:10px;font-weight:800}.brand img{width:40px;height:40px;object-fit:contain}.links{display:flex;align-items:center;gap:24px;font-size:.9rem;font-weight:700}.links a{color:rgba(255,255,255,.84)}.links a:hover{color:#fff}.facebook{padding:9px 15px;border-radius:999px;background:var(--blue);color:#fff!important}
    .page-hero{position:relative;overflow:hidden;background:linear-gradient(135deg,#041426,#0a2e54);color:#fff;padding:78px 0}.page-hero:after{content:"";position:absolute;width:420px;height:72px;right:-100px;bottom:10px;background:var(--red);transform:rotate(-45deg);border-radius:18px}.eyebrow{text-transform:uppercase;letter-spacing:.1em;font-size:.76rem;font-weight:900;color:#72b5ff}.page-hero h1{font-size:clamp(2.7rem,6vw,4.7rem);line-height:1;margin:10px 0 18px;letter-spacing:-.045em}.page-hero p{max-width:700px;color:rgba(255,255,255,.75);font-size:1.08rem;margin:0}
    main section.content{padding:70px 0}.prose{max-width:820px}.prose h2{font-size:1.8rem;margin:38px 0 10px}.prose h2:first-child{margin-top:0}.prose h3{margin:28px 0 8px}.prose p,.prose li{color:var(--muted)}.prose a{color:#1268d7;text-decoration:underline}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.card{padding:28px;border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:0 12px 34px rgba(14,43,72,.06)}.card h2,.card h3{margin-top:0}.tag{display:inline-block;padding:5px 9px;border-radius:999px;background:#e8f2ff;color:#1268d7;font-size:.76rem;font-weight:800}.btn{display:inline-flex;align-items:center;justify-content:center;padding:11px 18px;border-radius:999px;background:var(--blue);color:#fff!important;font-weight:800;margin-top:12px}.meta{color:var(--muted);font-size:.9rem}.article-list{display:grid;gap:18px}.article-card{padding:26px;border:1px solid var(--line);border-radius:18px;background:#fff}.article-card h2{margin:4px 0 8px;font-size:1.5rem}.article-card p{margin:0;color:var(--muted)}
    footer{background:#05172b;color:rgba(255,255,255,.68);padding:42px 0 24px}.footer-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:30px}.footer-brand{display:flex;align-items:center;gap:10px;color:#fff;font-weight:800;margin-bottom:10px}.footer-brand img{width:40px;height:40px}.footer-grid h4{color:#fff;margin:0 0 10px}.footer-grid ul{list-style:none;padding:0;margin:0;display:grid;gap:7px;font-size:.9rem}.copyright{margin-top:28px;padding-top:18px;border-top:1px solid rgba(255,255,255,.08);font-size:.8rem;text-align:center}
    @media(max-width:760px){.links a:not(.facebook){display:none}.grid,.footer-grid{grid-template-columns:1fr}.wrap{width:min(100% - 28px,1120px)}.page-hero{padding:58px 0}}
  </style>
</head>
<body>
<header><div class="wrap nav"><a class="brand" href="/"><img src="/kroma-logo.webp" alt="Kroma Digital logo"/><span>Kroma Digital</span></a><nav class="links"><a href="/about">About</a><a href="/apps">Apps</a><a href="/blog">Blog</a><a href="/contact">Contact</a><a class="facebook" href="https://www.facebook.com/kromadigitalapps" target="_blank" rel="noreferrer">Facebook</a></nav></div></header>
<main><slot /></main>
<footer><div class="wrap"><div class="footer-grid"><div><div class="footer-brand"><img src="/kroma-logo.webp" alt="Kroma Digital"/><span>Kroma Digital</span></div><p>Simple Android apps and digital tools for Cambodian businesses.</p></div><div><h4>Company</h4><ul><li><a href="/about">About</a></li><li><a href="/apps">Apps</a></li><li><a href="/blog">Blog</a></li><li><a href="/contact">Contact</a></li></ul></div><div><h4>Legal</h4><ul><li><a href="/privacy">Privacy Policy</a></li><li><a href="/terms">Terms</a></li></ul></div></div><div class="copyright">© {new Date().getFullYear()} Kroma Digital. Built for Cambodia.</div></div></footer>
</body></html>